---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	triagem(triagem)
	resposta_fixa(resposta_fixa)
	recuperar(recuperar)
	gerar_json(gerar_json)
	validar(validar)
	finalizar(finalizar)
	__end__([<p>__end__</p>]):::last
	__start__ --> triagem;
	gerar_json --> validar;
	recuperar --> gerar_json;
	resposta_fixa --> finalizar;
	triagem -.-> recuperar;
	triagem -.-> resposta_fixa;
	validar --> finalizar;
	finalizar --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
